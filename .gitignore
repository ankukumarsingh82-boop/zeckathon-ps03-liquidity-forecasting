# Local environment and caches (recreate with `pip install -r requirements.txt && pip install -e . --no-deps`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.streamlit/secrets.toml
.DS_Store
# Scratch
*.tmp
*.log.bak
# data/raw IS committed on purpose: ~18 MB of official downloads (one MANIFEST row per file) (AMFI, RBI, FBIL, NSE) with sha256 in
# data/raw/MANIFEST.csv. Source archives change or disappear (AMFI URLs, RBI press-release ids), so committing them is
# the only way a fresh clone reproduces every number byte-for-byte. No single file exceeds 1 MB.
# outputs/ and reports/ are committed too, so a clone can be diffed against a fresh `python -m liqfc run`.
